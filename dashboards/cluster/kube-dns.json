{
  "uid": "kube-dns-gke",
  "title": "kube-dns (GKE)",
  "description": "DNS health for GKE, which runs kube-dns rather than CoreDNS. The kube-prometheus-stack ships a CoreDNS dashboard that queries coredns_* metrics; GKE never emits those, so it is disabled in values.yaml and this dashboard covers the kubedns_* family instead. NOTE: the probe latency panels measure the kube-dns sidecar's synthetic health probes, not real client query latency - kube-dns exposes no per-query histogram.",
  "tags": ["kube-dns", "dns", "gke"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Scrape targets up",
      "description": "kube-dns exposes two metrics endpoints per pod (dnsmasq on 10054, kubedns on 10055), so this is 2x the pod count.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(up{job=\"kube-dns\"})",
          "legendFormat": "targets up"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "dnsmasq cache effectiveness. A sustained drop means more queries reach upstream, which shows up as slower pod startup and flaky service discovery.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(kubedns_dnsmasq_hits[$__rate_interval])) / clamp_min(sum(rate(kubedns_dnsmasq_hits[$__rate_interval])) + sum(rate(kubedns_dnsmasq_misses[$__rate_interval])), 0.001)",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cache evictions",
      "description": "Evictions per second. Anything sustained above zero means the cache is full and thrashing - dnsmasq is discarding entries it still needs.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(kubedns_dnsmasq_evictions[$__rate_interval]))",
          "legendFormat": "evictions/s"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Errors",
      "description": "dnsmasq errors plus both sidecar probe error counters. Should sit flat at zero.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.001 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(kubedns_dnsmasq_errors[$__rate_interval])) + sum(rate(kubedns_probe_dnsmasq_errors[$__rate_interval])) + sum(rate(kubedns_probe_kubedns_errors[$__rate_interval]))",
          "legendFormat": "errors/s"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cache hits vs misses",
      "description": "Lookup volume split by cache outcome. Misses are the queries that had to go upstream.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "misses" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(kubedns_dnsmasq_hits[$__rate_interval]))",
          "legendFormat": "hits"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(kubedns_dnsmasq_misses[$__rate_interval]))",
          "legendFormat": "misses"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Probe latency percentiles",
      "description": "p50/p95/p99 of the sidecar's synthetic DNS probes against dnsmasq and kubedns. Buckets are in MILLISECONDS (le 0.25 through 4096). This is health-probe latency, not client query latency.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(kubedns_probe_dnsmasq_latency_ms_bucket[$__rate_interval])))",
          "legendFormat": "dnsmasq p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(kubedns_probe_dnsmasq_latency_ms_bucket[$__rate_interval])))",
          "legendFormat": "dnsmasq p99"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(kubedns_probe_kubedns_latency_ms_bucket[$__rate_interval])))",
          "legendFormat": "kubedns p50"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(kubedns_probe_kubedns_latency_ms_bucket[$__rate_interval])))",
          "legendFormat": "kubedns p99"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cache churn: insertions vs evictions",
      "description": "Insertions filling the cache against evictions emptying it. Evictions tracking insertions means the cache is saturated and the hit ratio will degrade.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(kubedns_dnsmasq_insertions[$__rate_interval]))",
          "legendFormat": "insertions"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(kubedns_dnsmasq_evictions[$__rate_interval]))",
          "legendFormat": "evictions"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Errors by source",
      "description": "Separated so you can tell a dnsmasq fault from a probe failure. Any non-zero line is worth investigating.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(kubedns_dnsmasq_errors[$__rate_interval]))",
          "legendFormat": "dnsmasq"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(kubedns_probe_dnsmasq_errors[$__rate_interval]))",
          "legendFormat": "probe dnsmasq"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(kubedns_probe_kubedns_errors[$__rate_interval]))",
          "legendFormat": "probe kubedns"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Cache size vs capacity",
      "description": "Approximate live entry count (insertions minus evictions, per pod) against dnsmasq's configured max cache size. Converging lines mean the cache is full.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "capacity.*" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (pod) (kubedns_dnsmasq_insertions - kubedns_dnsmasq_evictions)",
          "legendFormat": "entries {{pod}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max(kubedns_dnsmasq_max_size)",
          "legendFormat": "capacity"
        }
      ]
    }
  ]
}
